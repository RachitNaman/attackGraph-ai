# ============================================================
# APPLICATION
# ============================================================
APP_NAME="AttackGraph AI"
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# ============================================================
# NEO4J
# bolt:// = direct connection | neo4j:// = clustered connection
# In Docker: use container name as host → neo4j:7687
# In local dev: use localhost:7687
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j          # default database name

# ============================================================
# QDRANT
# ============================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=               # Leave empty for local dev, required in cloud

# Qdrant collection names
QDRANT_CVE_COLLECTION=cve_descriptions
QDRANT_ASSETS_COLLECTION=asset_metadata
QDRANT_THREAT_INTEL_COLLECTION=threat_intel

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# GEMINI (Google AI)
# Get from: https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_TEMPERATURE=0.1        # Low temp = more deterministic/factual
GEMINI_MAX_TOKENS=8192

# ============================================================
# LANGCHAIN / LANGGRAPH
# ============================================================
LANGCHAIN_TRACING_V2=true     # Enable LangSmith tracing (optional but useful)
LANGCHAIN_API_KEY=            # Get from smith.langchain.com
LANGCHAIN_PROJECT=attackgraph-ai

# ============================================================
# CORS (Frontend URL)
# ============================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ============================================================
# VECTOR DIMENSIONS
# Gemini text-embedding-004 produces 768-dimensional vectors
# ============================================================
EMBEDDING_DIMENSIONS=768

# ============================================================
# ATTACK ANALYSIS SETTINGS
# ============================================================
MAX_ATTACK_PATH_HOPS=8        # Maximum hops in path traversal
MAX_PATHS_RETURNED=10         # Maximum paths returned to user
PATH_SCORE_CVSS_WEIGHT=0.6    # How much CVSS score affects path risk score
PATH_SCORE_HOP_WEIGHT=0.4     # How much hop count affects path risk score

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_PER_MINUTE=30

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=DEBUG               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | text (use json in production)